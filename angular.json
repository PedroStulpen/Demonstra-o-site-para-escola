{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": { "escola-demo": {
    "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
    "architect": {
      "build": { "builder": "@angular-devkit/build-angular:application", "options": {
        "outputPath": "dist/escola-demo", "index": "src/index.html", "browser": "src/main.ts",
        "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json",
        "styles": ["node_modules/bootstrap/dist/css/bootstrap.min.css", "node_modules/bootstrap-icons/font/bootstrap-icons.css", "src/styles.scss"],
        "scripts": ["node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"] },
        "configurations": { "production": { "outputHashing": "all" }, "development": { "optimization": false, "sourceMap": true } },
        "defaultConfiguration": "production" },
      "serve": { "builder": "@angular-devkit/build-angular:dev-server",
        "configurations": { "production": { "buildTarget": "escola-demo:build:production" }, "development": { "buildTarget": "escola-demo:build:development" } },
        "defaultConfiguration": "development" }
    }
  }
},
"cli": {
  "analytics": "cd471b88-318c-4937-9755-10f8ded2e758"
}
}
